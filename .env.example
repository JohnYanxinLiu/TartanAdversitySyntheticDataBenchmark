# Copy this file to `.env`, fill in your own values, then load it before running:
#
#     cp .env.example .env
#     source .env
#
# `.env` is git-ignored so your credentials never get committed.

# --- Weights & Biases ---------------------------------------------------------
# API key for experiment logging. Find yours at https://wandb.ai/authorize
export WANDB_API_KEY="your-wandb-api-key"

# W&B entity (team or username) and project to log runs under. These override
# the values in configs/base.yaml.
export WANDB_ENTITY="your-wandb-entity"
export WANDB_PROJECT="your-wandb-project"
